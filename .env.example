# --- Core ---
DATABASE_URL=postgresql://bridgebox:bridgebox@localhost:5432/bridgebox
AUTH_SECRET=change-me-32-bytes-min
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# AES-256-GCM key for credential vault (base64, 32 bytes). Generate: openssl rand -base64 32
VAULT_KEY=
# Shared secret for the scheduler tick (POST/GET /api/jobs/run with header x-cron-secret). Generate: openssl rand -hex 32
CRON_SECRET=
# --- Optional integrations (leave blank to disable; UI shows "not configured") ---
N8N_BASE_URL=
N8N_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
ANTHROPIC_API_KEY=
# OIDC SSO (any provider: Entra ID, Okta, Google Workspace)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Process-mining adapters (licensed; see docs/INTEGRATIONS.md)
POWER_AUTOMATE_TENANT_ID=
POWER_AUTOMATE_CLIENT_ID=
POWER_AUTOMATE_CLIENT_SECRET=
UIPATH_ORG=
UIPATH_TENANT=
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
MIMICA_API_KEY=
# Optional per-unit Stripe Prices for add-ons (checkout with extra seats/slots refuses without them)
STRIPE_PRICE_EXTRA_SEAT=
STRIPE_PRICE_EXTRA_AGENT=
# --- Dev / ops (optional) ---
# Password for the seeded demo accounts (scripts/seed.ts). Default outside production: Demo!Pass123.
# In production (VERCEL_ENV=production or NODE_ENV=production) the default is refused: set >= 16 chars or a random one is generated and not printed.
SEED_PASSWORD=
# Self-hosted worker poll interval in ms (scripts/worker.ts). Default: 5000
WORKER_POLL_MS=
# Playwright: point the e2e suite at another host / time zone (defaults: http://localhost:3000, America/Chicago)
E2E_BASE_URL=
E2E_TZ=
# Optional: run inside a dedicated schema of a shared database (e.g. Supabase). Leave blank for a dedicated DB.
DB_SCHEMA=
# Set to "require" for managed Postgres over TLS (Supabase/Neon)
DATABASE_SSL=
# Platform owner (full privileges across the consultancy + all client orgs). Store a bcrypt HASH, never the password:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" "<password>"
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
# --- Security / production readiness (docs/SECURITY.md, docs/DEPLOYMENT.md) ---
# Seed the synthetic demo at the end of `npm run build` (Vercel/Docker). Only "1" seeds; unset = never (SEC-001).
BOOTSTRAP_SEED_DEMO=
# Skip migrations/seed at the end of `npm run build`.
SKIP_BOOTSTRAP=
# "1" lets *.demo / demo-org-only accounts sign in under a production runtime (`next start`, Vercel production). CI/e2e only. Never in production.
ALLOW_DEMO_LOGINS=
# "0" stops enqueued analysis jobs from starting right away via after(); the daily cron/worker then picks them up. e2e sets 0.
JOBS_KICK_ON_ENQUEUE=
# Minutes after which a 'running' job's lock is considered stale and recovered (default 10; the worker uses >= 30).
JOB_STALE_MINUTES=
# Time budget for one /api/jobs/run tick before it stops claiming new jobs, ms (default 45000, max 55000).
JOB_TICK_BUDGET_MS=
# Per-organization AI Brain storage quota in bytes of stored document text (default 52428800 = 50 MB).
BRAIN_ORG_QUOTA_BYTES=

# Optional, time-boxed (max 14 days) grace before the platform owner must enrol MFA; shows a banner instead of redirecting.
# OWNER_MFA_GRACE_UNTIL=2026-11-14T23:59:59-06:00
