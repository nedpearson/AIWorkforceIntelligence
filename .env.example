# --- Core ---
DATABASE_URL=postgresql://bridgebox:bridgebox@localhost:5432/bridgebox
AUTH_SECRET=change-me-32-bytes-min
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# AES-256-GCM key for credential vault (base64, 32 bytes). Generate: openssl rand -base64 32
VAULT_KEY=
# Shared secret for the scheduler tick (POST/GET /api/jobs/run with header x-cron-secret). Generate: openssl rand -hex 32
CRON_SECRET=
# --- Optional integrations (leave blank to disable; UI shows "not configured") ---
N8N_BASE_URL=
N8N_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
ANTHROPIC_API_KEY=
# OIDC SSO (any provider: Entra ID, Okta, Google Workspace)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Process-mining adapters (licensed; see docs/INTEGRATIONS.md)
POWER_AUTOMATE_TENANT_ID=
POWER_AUTOMATE_CLIENT_ID=
POWER_AUTOMATE_CLIENT_SECRET=
UIPATH_ORG=
UIPATH_TENANT=
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
MIMICA_API_KEY=
# Optional per-unit Stripe Prices for add-ons (checkout with extra seats/slots refuses without them)
STRIPE_PRICE_EXTRA_SEAT=
STRIPE_PRICE_EXTRA_AGENT=
# --- Dev / ops (optional) ---
# Password for the seeded demo accounts (scripts/seed.ts). Default: Demo!Pass123
SEED_PASSWORD=
# Self-hosted worker poll interval in ms (scripts/worker.ts). Default: 5000
WORKER_POLL_MS=
# Playwright: point the e2e suite at another host / time zone (defaults: http://localhost:3000, America/Chicago)
E2E_BASE_URL=
E2E_TZ=
